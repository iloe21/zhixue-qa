# ============================================================
# Docker 部署环境变量模板 —— 复制为 .env 后填入真实值
# （.env 已被 .gitignore 排除，不会提交；.env.example 例外保留在仓库）
# ============================================================

# 必填：阿里百炼 API Key（https://bailian.console.aliyun.com）
# 也可为任何 OpenAI 兼容服务，配合 AI_BASE_URL 一起改
AI_API_KEY=sk-你的百炼Key

# 可选覆盖（不填则用默认值）
#AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
#AI_CHAT_MODEL=qwen-plus
#AI_EMBEDDING_MODEL=text-embedding-v4

# MySQL root 密码（仅首次初始化卷时生效）
#DB_PASSWORD=zhixue_dev_2026

# JWT 签名密钥（至少 32 字符；对外部署务必修改）
#JWT_SECRET=replace-with-a-random-32-char-or-longer-secret
